+@pytest.mark.parametrize(
+    "entry",
+    [
+        ("../outside.distcp", 0, 1),
+        ("/outside.distcp", 0, 1),
+        ("shard.distcp", -1, 1),
+        ("shard.distcp", 0, 0),
+    ],
+)
+def test_invalid_storage_entries_are_rejected(entry):
+    with pytest.raises(ValueError):
+        ckpt.checkpoint_shard_sizes(metadata_bytes([entry]))
