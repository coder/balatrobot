+@pytest.mark.parametrize("no_save_rng", [False, True])
+def test_retry_restores_training_state_after_fresh_parent_load(no_save_rng):
+    source = {
+        "ckpt_step": 399,
+        "ref_ckpt_step": 0,
+        "finetune": True,
+        "no_load_rng": True,
+        "no_save_rng": no_save_rng,
+    }
+    cfg = SimpleNamespace(extra_config=source)
+    pin_resume_iteration(cfg, 19)
+    actual = yaml.safe_load(Path(cfg.extra_config).read_text())
+    assert actual["ckpt_step"] == 19
+    assert actual["ref_ckpt_step"] == 0
+    assert actual["finetune"] is False
+    assert actual["no_load_rng"] is no_save_rng
+    assert source["finetune"] is True
+    assert source["ckpt_step"] == 399
+    Path(cfg.extra_config).unlink()
+
